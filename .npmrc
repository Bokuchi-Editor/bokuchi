# Supply-chain protections. See docs/DEVELOPMENT.md ("npm Configuration") before changing.

# Do not run install scripts (postinstall, etc.) of dependencies.
# Protects against malicious packages. No current dependency requires them.
ignore-scripts=true

# Do not resolve package versions published less than 3 days ago.
# Requires npm >= 11.10; older npm silently ignores this setting.
min-release-age=3

# Run a security audit on install.
audit=true
